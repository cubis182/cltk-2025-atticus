fviz_dist(distance, gradient = list(low = "#00AFBB", mid = "white", high = "#FC4E07")) + distance_labels
ggsave(filename = "Images/Distance plot with main d.f.png", dpi = "print")
View(as.matrix(distance))
?select
?filter
View(kmeans_basic_cluster)
?xlim
cluster_main + xlim(0, 5.5) + ylim(-3, 3)
ggsave(filename = "Images/history-cluster-diagram-kmeans.png", dpi = "print")
cluster_main + xlim(0, 5.5) + ylim(-3, 3) + geom_text_repel(aes(label = rownames(df_clust)), vjust = "inward", hjust = "inward", max.overlaps = 15, size = 2, seed = 12927)
ggsave(filename = "Images/history-cluster-diagram-kmeans.png", dpi = "print")
